# Copy to terraform.tfvars (DO NOT commit terraform.tfvars — real values stay local)
# Fill in actual values before running terraform plan/apply

env         = "staging"
aws_region  = "us-east-1"
name_prefix = "sidoc-ai-marketing"

# Confirmed subdomains (SIDOC, 2026-05-28)
dashboard_fqdn = "marketing.stg.sidocsa.com"
api_fqdn       = "api.marketing.stg.sidocsa.com"

# Phase flag — keep false on first apply (cert created in PENDING, validation
# records emitted as output → send to SIDOC). Flip true after SIDOC adds the
# CNAME and the cert reaches ISSUED, then apply again to attach the CloudFront alias.
dashboard_dns_enabled = false

# Email for CloudWatch alarm notifications (E-00.6)
# alert_email = "yonnathan.henao@morphux.co"

# Langfuse host. Default is Cloud; override to self-hosted if SIDOC requires.
# langfuse_host = "https://cloud.langfuse.com"
