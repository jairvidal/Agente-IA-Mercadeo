# --- HTTP -------------------------------------------------------------------
BACKEND_PORT=3000
PROJECT_NAME=sidoc-backend

# --- Telegram channel -------------------------------------------------------
# Bot token issued by @BotFather. Required.
TELEGRAM_BOT_TOKEN=
# Shared secret for the webhook callback (sent in X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# --- Redis (sessions) -------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- MCP server -------------------------------------------------------------
MCP_SERVER_URL=http://localhost:3001
# Internal bearer token shared with the MCP server. Required.
MCP_INTERNAL_TOKEN=
# Optional. Per-call timeout for MCP operations. Default: 10000.
MCP_TIMEOUT_MS=10000

# --- LLM provider -----------------------------------------------------------
# One of: openai | anthropic | gemini. Required.
LLM_PROVIDER=gemini
# Model id for the selected provider. Required.
#   gemini   -> gemini-2.0-flash-lite
#   openai   -> gpt-4o-mini
#   anthropic-> claude-3-5-haiku-20241022
LLM_MODEL=gemini-2.0-flash-lite

# Provide ONLY the key for the active LLM_PROVIDER (the others can stay empty).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional. Sampling temperature. Default: 0.3.
LLM_TEMPERATURE=0.3
# Optional. Per-call timeout in ms (AbortSignal.timeout). Default: 30000.
LLM_TIMEOUT_MS=30000

# Optional. Comma-separated fallback chain ("provider:model,provider:model").
# Each entry needs its API key set above. Duplicates of the primary are ignored.
# Example: LLM_FALLBACK_CHAIN=openai:gpt-4o-mini,anthropic:claude-3-5-haiku-20241022
LLM_FALLBACK_CHAIN=
